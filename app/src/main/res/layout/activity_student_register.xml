<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRegisterRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/welcome_bg"
    tools:context=".StudentRegisterActivity">

    <!-- Top App Bar / Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_dark"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarRegister"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="Navigate back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/white"
            app:title="@string/register_title"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Form Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_large"
            android:paddingTop="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_large"
            android:paddingBottom="@dimen/spacing_xlarge">

            <!-- Subtitle Header -->
            <TextView
                android:id="@+id/tvRegisterSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_large"
                android:lineSpacingExtra="3dp"
                android:text="@string/register_subtitle"
                android:textColor="@color/tagline_charcoal"
                android:textSize="@dimen/text_size_normal" />

            <!-- Global Feedback / Status Banner (gone by default) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRegisterStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:visibility="gone"
                app:cardBackgroundColor="#E6F4EA"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="#34A853"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvRegisterStatusMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium"
                    android:text="@string/registration_success_message"
                    android:textColor="#137333"
                    android:textSize="@dimen/text_size_normal"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 1. Full Student Name Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFullName"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:hint="@string/label_name"
                app:errorEnabled="true"
                app:helperText="@string/helper_name"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="100"
                    android:textColor="@color/title_dark_slate"
                    android:textColorHint="@color/tagline_charcoal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 2. Student Number Input (9 digits, preserves leading zeroes) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStudentNumber"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:hint="@string/label_student_number"
                app:errorEnabled="true"
                app:helperText="@string/helper_student_number"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStudentNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="9"
                    android:textColor="@color/title_dark_slate"
                    android:textColorHint="@color/tagline_charcoal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 3. Programme Dropdown Selector (CS, IT, DS) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilProgramme"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:hint="@string/label_programme"
                app:boxStrokeColor="@color/primary_dark"
                app:boxStrokeWidth="1.5dp"
                app:errorEnabled="true"
                app:hintTextColor="@color/primary_dark">

                <AutoCompleteTextView
                    android:id="@+id/actvProgramme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/label_programme"
                    android:inputType="none"
                    android:textColor="@color/title_dark_slate"
                    android:textColorHint="@color/tagline_charcoal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 4. Claim Code Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilClaimCode"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:hint="@string/label_claim_code"
                app:errorEnabled="true"
                app:helperText="@string/helper_claim_code"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etClaimCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLength="20"
                    android:textColor="@color/title_dark_slate"
                    android:textColorHint="@color/tagline_charcoal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 5. Password Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:hint="@string/label_password"
                app:endIconMode="password_toggle"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/title_dark_slate"
                    android:textColorHint="@color/tagline_charcoal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 6. Confirm Password Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmPassword"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_large"
                android:hint="@string/label_confirm_password"
                app:endIconMode="password_toggle"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/title_dark_slate"
                    android:textColorHint="@color/tagline_charcoal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Register Primary Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitRegister"
                android:layout_width="match_parent"
                android:layout_height="@dimen/portal_button_height"
                android:backgroundTint="@color/action_teal"
                android:elevation="2dp"
                android:text="@string/action_register"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <!-- "Already registered? Sign in here" Navigation Link -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_large"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/msg_already_have_account"
                    android:textColor="@color/tagline_charcoal"
                    android:textSize="@dimen/text_size_normal" />

                <TextView
                    android:id="@+id/btnNavToSignIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:minHeight="@dimen/min_touch_target"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/action_sign_in_link"
                    android:textColor="@color/action_teal"
                    android:textSize="@dimen/text_size_normal"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
