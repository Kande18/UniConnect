<?xml version="1.0" encoding="utf-8"?>
<!--
    layout_fragment_lecturer_requests.xml
    ======================================
    Lecturer Tab 4: Student Group Change Requests & Approvals (§13.7 & §14.7)
    Features:
      - Pending requests count header
      - Interactive student request cards with reason, current group, requested group
      - Approve and Decline action buttons with instant feedback
      - Empty state when all requests are reviewed
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/welcome_bg"
    android:fillViewport="true"
    android:padding="16dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── 1. HEADER WITH PENDING CHIP ───────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PENDING APPROVALS"
                android:textColor="@color/label_slate"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPendingCount"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="2 Pending"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:chipBackgroundColor="@color/action_teal"
                app:chipStrokeWidth="0dp"
                app:chipMinHeight="28dp"
                android:clickable="false"
                android:focusable="false"
                tools:ignore="SmallSp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Review and approve student requests to change laboratory groups."
            android:textColor="@color/tagline_charcoal"
            android:textSize="13sp" />

        <!-- ── BANNER FEEDBACK (hidden initially) ────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bannerRequestFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="#E8F5E9"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvRequestFeedbackMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Request approved successfully."
                android:textColor="@color/status_success"
                android:textSize="13sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ── REQUEST CARD 1 ────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRequest1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Student Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:gravity="center"
                        android:text="P"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Peculiar Banda"
                            android:textColor="@color/title_dark_slate"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="202400123 • CS"
                            android:textColor="@color/tagline_charcoal"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today, 09:15"
                        android:textColor="@color/tagline_charcoal"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Transfer Flow: From G01 -> G02 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#F8FAFC"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current: G01 (14/15)"
                        android:textColor="@color/tagline_charcoal"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:text="➔"
                        android:textColor="@color/action_teal"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Target: G02 (10/15)"
                        android:textColor="@color/action_teal"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Student Reason -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reason: Timetable conflict with CS302 Advanced Algorithms lecture on Monday mornings."
                    android:textColor="@color/label_slate"
                    android:textSize="12sp"
                    android:layout_marginBottom="14dp" />

                <!-- Action Buttons / Status Container -->
                <LinearLayout
                    android:id="@+id/layoutActions1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDecline1"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Decline"
                        android:textColor="@color/status_error"
                        app:strokeColor="@color/status_error"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApprove1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Approve"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/action_teal"
                        app:cornerRadius="8dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatusResult1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="✓ Approved"
                    android:textColor="@color/status_success"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── REQUEST CARD 2 ────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRequest2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:gravity="center"
                        android:text="T"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tendai Moyo"
                            android:textColor="@color/title_dark_slate"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="202400789 • DS"
                            android:textColor="@color/tagline_charcoal"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yesterday"
                        android:textColor="@color/tagline_charcoal"
                        android:textSize="11sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#F8FAFC"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current: G02 (10/15)"
                        android:textColor="@color/tagline_charcoal"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:text="➔"
                        android:textColor="@color/action_teal"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Target: G03 (9/15)"
                        android:textColor="@color/action_teal"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reason: Medical appointment scheduled weekly during Tuesday afternoon slot."
                    android:textColor="@color/label_slate"
                    android:textSize="12sp"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:id="@+id/layoutActions2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDecline2"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Decline"
                        android:textColor="@color/status_error"
                        app:strokeColor="@color/status_error"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApprove2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Approve"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/action_teal"
                        app:cornerRadius="8dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatusResult2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="✓ Approved"
                    android:textColor="@color/status_success"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── EMPTY STATE (shown when all reviewed) ─────────────────── -->
        <LinearLayout
            android:id="@+id/layoutRequestsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="All Requests Handled!"
                android:textColor="@color/title_dark_slate"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No pending student group transfer requests."
                android:textColor="@color/tagline_charcoal"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
