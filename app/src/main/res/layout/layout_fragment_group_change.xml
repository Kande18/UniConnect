<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/welcome_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_large"
        android:paddingEnd="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_xlarge">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Group Transfer Request"
            android:textColor="@color/title_dark_slate"
            android:textSize="@dimen/text_size_xlarge"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:text="Request a transfer to a different practical lab group"
            android:textColor="@color/tagline_charcoal"
            android:textSize="@dimen/text_size_normal" />

        <!-- 1. LIVE REQUEST STATUS CARD (§13.7 & §16) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTransferStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            app:cardBackgroundColor="#F8FAFC"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Request Status"
                    android:textColor="@color/tagline_charcoal"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/tvLiveRequestStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="No Active Request"
                    android:textColor="@color/title_dark_slate"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLiveRequestDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="You are currently assigned to Group G01. You may submit a request below."
                    android:textColor="@color/tagline_charcoal"
                    android:textSize="@dimen/text_size_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. CURRENT LAB GROUP DISPLAY -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Assignment: Group G01 (12 / 15 Students)"
            android:textColor="@color/primary_dark"
            android:textSize="@dimen/text_size_normal"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="@dimen/spacing_small"
            android:text="Select Desired Target Group:"
            android:textColor="@color/title_dark_slate"
            android:textSize="@dimen/text_size_normal"
            android:textStyle="bold" />

        <!-- 3. TARGET GROUP SELECTION RADIO GROUP -->
        <RadioGroup
            android:id="@+id/rgTargetGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Option G02 (Available) -->
            <RadioButton
                android:id="@+id/rbGroupG02"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch_target"
                android:checked="true"
                android:text="Group G02 — 10 / 15 Students (5 Available)"
                android:textColor="@color/title_dark_slate"
                android:textSize="@dimen/text_size_normal" />

            <!-- Option G03 (Available) -->
            <RadioButton
                android:id="@+id/rbGroupG03"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch_target"
                android:text="Group G03 — 9 / 15 Students (6 Available)"
                android:textColor="@color/title_dark_slate"
                android:textSize="@dimen/text_size_normal" />

            <!-- Option G04 (Full - Disabled per §19) -->
            <RadioButton
                android:id="@+id/rbGroupG04"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch_target"
                android:enabled="false"
                android:text="Group G04 — 15 / 15 Students [FULL]"
                android:textColor="#94A3B8"
                android:textSize="@dimen/text_size_normal" />
        </RadioGroup>

        <!-- 4. REASON FOR REQUEST -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTransferReason"
            style="@style/Widget.App.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_large"
            android:hint="Reason for transfer request (optional)"
            app:helperText="e.g. Timetable clash, transport constraints"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTransferReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:lines="3"
                android:textColor="@color/title_dark_slate"
                android:textColorHint="@color/tagline_charcoal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 5. SUBMIT ACTION BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitTransferRequest"
            android:layout_width="match_parent"
            android:layout_height="@dimen/portal_button_height"
            android:backgroundTint="@color/action_teal"
            android:text="Submit Transfer Request"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
