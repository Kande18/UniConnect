<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/welcome_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_large"
        android:paddingEnd="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_xlarge">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textColor="@color/title_dark_slate"
            android:textSize="@dimen/text_size_xlarge"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:text="Update your personal and academic programme information"
            android:textColor="@color/tagline_charcoal"
            android:textSize="@dimen/text_size_normal" />

        <!-- Status / Feedback Banner (gone by default) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEditProfileStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:visibility="gone"
            app:cardBackgroundColor="#E6F4EA"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="#34A853"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvEditProfileStatusMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_medium"
                android:text="✓ Profile changes saved successfully!"
                android:textColor="#137333"
                android:textSize="@dimen/text_size_normal"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Information Notice for Locked Student Number (§13.6) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            app:cardBackgroundColor="#F8FAFC"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="Students may edit name and programme. The 9-digit student number cannot be edited directly; contact a lecturer to request a correction."
                    android:textColor="@color/tagline_charcoal"
                    android:textSize="@dimen/text_size_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1. Editable Full Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEditFullName"
            style="@style/Widget.App.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="@string/label_name"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEditFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:text="Peculiar Banda"
                android:textColor="@color/title_dark_slate"
                android:textColorHint="@color/tagline_charcoal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 2. Editable Programme Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEditProgramme"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="@string/label_programme"
            app:boxStrokeColor="@color/primary_dark"
            app:boxStrokeWidth="1.5dp"
            app:errorEnabled="true"
            app:hintTextColor="@color/primary_dark">

            <AutoCompleteTextView
                android:id="@+id/actvEditProgramme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/label_programme"
                android:inputType="none"
                android:text="CS (Computer Science)"
                android:textColor="@color/title_dark_slate"
                android:textColorHint="@color/tagline_charcoal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 3. Locked Student Number (§13.6) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEditStudentNumber"
            style="@style/Widget.App.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:enabled="false"
            android:hint="@string/label_student_number"
            app:helperText="Locked. Contact academic staff for correction."
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEditStudentNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none"
                android:text="202400123"
                android:textColor="#64748B"
                android:textColorHint="@color/tagline_charcoal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfileChanges"
            android:layout_width="match_parent"
            android:layout_height="@dimen/portal_button_height"
            android:backgroundTint="@color/action_teal"
            android:text="Save Profile Changes"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelEditProfile"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/portal_button_height"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="Cancel &amp; Return to Profile"
            android:textColor="@color/tagline_charcoal"
            app:cornerRadius="12dp"
            app:strokeColor="#CBD5E1" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
