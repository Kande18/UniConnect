<?xml version="1.0" encoding="utf-8"?>
<!--
    Root changed from CoordinatorLayout + fixed 60dp margins to a vertical LinearLayout.
    The bottom navigation now sizes itself (wrap_content) so labels are not clipped at 200% text size.
    All view IDs are unchanged.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutStudentPortalRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/welcome_bg"
    tools:context=".StudentProfileActivity">

    <!-- Top App Bar / Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutPortal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_dark"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarStudentPortal"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/student_portal_title"
            app:titleTextColor="@color/white">

            <!-- Sign Out Action Button on Toolbar Right (§21) -->
            <ImageView
                android:id="@+id/btnToolbarSignOut"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:layout_gravity="end"
                android:layout_marginEnd="12dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/desc_sign_out_student"
                android:src="@drawable/ic_logout"
                app:tint="@color/white" />

        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Dynamic Tab Container (fills the space between toolbar and bottom nav) -->
    <FrameLayout
        android:id="@+id/fragmentContainerStudent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 4-Button Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_student_bottom_nav" />

</LinearLayout>
