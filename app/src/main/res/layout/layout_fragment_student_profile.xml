<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="UnusedAttribute"
    android:background="@color/welcome_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_large"
        android:paddingEnd="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_xlarge">

        <!-- Header Greeting & Status Chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProfileStudentNameHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mock_student_name"
                    android:textColor="@color/title_dark_slate"
                    android:textSize="@dimen/text_size_xlarge"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileStudentNumberHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/mock_student_id_header"
                    android:textColor="@color/tagline_charcoal"
                    android:textSize="@dimen/text_size_normal" />
            </LinearLayout>

            <!-- Sync Status Chip (§16) -->
            <TextView
                android:id="@+id/chipProfileSyncStatus"
                android:accessibilityLiveRegion="polite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/status_success_bg"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/state_synced"
                android:textColor="@color/status_success_text"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 1. STUDENT PROFILE INFORMATION CARD (§13.4) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/divider_slate"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_academic_details"
                    android:accessibilityHeading="true"
                    android:textColor="@color/primary_dark"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:background="@color/divider_slate" />

                <!-- Row 1: Full Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_name"
                    android:textColor="@color/tagline_charcoal"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/tvDisplayFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:text="@string/mock_student_name"
                    android:textColor="@color/title_dark_slate"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <!-- Row 2: Programme -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_programme"
                    android:textColor="@color/tagline_charcoal"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/tvDisplayProgramme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:text="@string/mock_programme_display"
                    android:textColor="@color/title_dark_slate"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <!-- Row 3: Student Number (Locked) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_student_number"
                    android:textColor="@color/tagline_charcoal"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/tvDisplayStudentNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/mock_student_number"
                    android:textColor="@color/title_dark_slate"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <!-- Correction Pathway helper link (§13.4) -->
                <TextView
                    android:id="@+id/btnRequestCorrection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="@dimen/min_touch_target"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/profile_request_correction"
                    android:textColor="@color/action_teal"
                    android:textSize="@dimen/text_size_small" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. CONFIRMED LAB GROUP SUMMARY CARD (§13.5) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/divider_slate"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_confirmed_group"
                        android:accessibilityHeading="true"
                        android:textColor="@color/primary_dark"
                        android:textSize="@dimen/text_size_medium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGroupBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_student_portal"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="@string/mock_group_badge"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_medium"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOccupancySummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/mock_occupancy_summary"
                    android:textColor="@color/tagline_charcoal"
                    android:textSize="@dimen/text_size_normal" />

                <!-- Linear Progress Indicator -->
                <ProgressBar
                    android:id="@+id/progressOccupancy"
                    android:importantForAccessibility="no"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:max="15"
                    android:progress="12"
                    android:progressTint="@color/action_teal" />

                <!-- Action to switch to Group Details tab -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickViewGroup"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/portal_button_height"
                    android:text="@string/profile_view_group_details"
                    android:textColor="@color/action_teal"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/action_teal" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. QUICK SHORTCUTS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickEditProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/portal_button_height"
                android:layout_marginEnd="@dimen/spacing_small"
                android:layout_weight="1"
                android:backgroundTint="@color/action_teal"
                android:text="@string/profile_btn_edit"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickRequestTransfer"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/portal_button_height"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:text="@string/profile_btn_transfer"
                android:textColor="@color/primary_dark"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="@color/primary_dark" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
