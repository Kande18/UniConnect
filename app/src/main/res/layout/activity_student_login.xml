<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutStudentLoginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/welcome_bg"
    tools:context=".StudentLoginActivity">

    <!-- Top App Bar / Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_dark"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarStudentLogin"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="Navigate back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/white"
            app:title="@string/student_portal_title"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_large"
            android:paddingTop="@dimen/spacing_large"
            android:paddingEnd="@dimen/spacing_large"
            android:paddingBottom="@dimen/spacing_xlarge">

            <!-- App Logo Badge -->
            <ImageView
                android:id="@+id/ivLoginAppLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:contentDescription="@string/desc_app_logo"
                android:src="@drawable/ic_app_logo" />

            <!-- Title & Subtitle -->
            <TextView
                android:id="@+id/tvLoginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_welcome_back"
                android:textColor="@color/title_dark_slate"
                android:textSize="@dimen/text_size_xlarge"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLoginSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="@dimen/spacing_large"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/login_student_subtitle"
                android:textColor="@color/tagline_charcoal"
                android:textSize="@dimen/text_size_normal" />

            <!-- Error Banner (hidden by default) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLoginError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:visibility="gone"
                app:cardBackgroundColor="#FDE8E8"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="#F05252"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvLoginErrorMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium"
                    android:text="@string/error_invalid_credentials"
                    android:textColor="@color/status_error"
                    android:textSize="@dimen/text_size_normal" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 1. Student Number Input Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStudentNumber"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:hint="@string/label_student_number"
                app:errorEnabled="true"
                app:helperText="@string/helper_student_number"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStudentNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="9"
                    android:textColor="@color/title_dark_slate"
                    android:textColorHint="@color/tagline_charcoal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 2. Password Input Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_large"
                android:hint="@string/label_password"
                app:endIconMode="password_toggle"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/title_dark_slate"
                    android:textColorHint="@color/tagline_charcoal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Sign In Primary Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/portal_button_height"
                android:backgroundTint="@color/action_teal"
                android:elevation="2dp"
                android:text="@string/btn_sign_in"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <!-- "Don't have an account? Register" Link -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/msg_no_account"
                    android:textColor="@color/tagline_charcoal"
                    android:textSize="@dimen/text_size_normal" />

                <TextView
                    android:id="@+id/tvLinkRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:minHeight="@dimen/min_touch_target"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/action_register_now"
                    android:textColor="@color/action_teal"
                    android:textSize="@dimen/text_size_normal"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Switch to Lecturer Portal link -->
            <TextView
                android:id="@+id/tvLinkLecturerSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:minHeight="@dimen/min_touch_target"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/link_lecturer_sign_in"
                android:textColor="@color/secondary_blue"
                android:textSize="@dimen/text_size_normal" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
