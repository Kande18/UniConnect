<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main application theme -->
    <style name="Theme.UniConnect" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary -->
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/secondary_blue</item>
        <item name="colorSecondaryVariant">@color/secondary_blue</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/action_teal</item>
        <item name="colorOnTertiary">@android:color/white</item>

        <!-- Error -->
        <item name="colorError">@color/status_error</item>
        <item name="colorOnError">@android:color/white</item>

    </style>

    <!-- Primary button -->
    <style name="Widget.App.PrimaryButton"
        parent="Widget.MaterialComponents.Button">

        <item name="backgroundTint">@color/action_teal</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>

    </style>

    <!-- Secondary button -->
    <style name="Widget.App.SecondaryButton"
        parent="Widget.MaterialComponents.Button.OutlinedButton">

        <item name="strokeColor">@color/secondary_blue</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/secondary_blue</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>

    </style>

    <!-- Text input -->
    <style name="Widget.App.TextInput"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <item name="boxStrokeColor">@color/primary_dark</item>
        <item name="boxBackgroundMode">outline</item>

    </style>

    <!-- Status chip -->
    <style name="Widget.App.StatusChip"
        parent="Widget.MaterialComponents.Chip.Entry">

        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="chipBackgroundColor">?attr/colorSurface</item>
        <item name="chipIconVisible">true</item>
        <item name="android:iconTint">?attr/colorOnSurface</item>
        <item name="android:minHeight">48dp</item>

    </style>

</resources>